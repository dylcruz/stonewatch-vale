[gd_resource type="Resource" script_class="ValeQuestDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/quest_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"birchwater_delivery"
title = "The Ferryman's Lost Bundle"
briefing = "I lost a bundle unloading at the timber bridge upriver. Look for the red cloth on the rail. My bundle has the same wrap. The west bank is quicker, but a wolf hunts there. Cross here for the quiet east trail."
objective = "Find the red-wrapped bundle near the timber bridge"
return_objective = "Bring the bundle to the ferryman at Birchwater Ford"
turn_in_dialogue = "That's the one! Set it on the cart. The ferry can make its delivery after all."
target_object = &"birchwater_bundle"
reward_xp = 85
