[gd_resource type="Resource" script_class="ValeQuestDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/quest_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"birchwater_delivery"
title = "The Ferryman's Lost Bundle"
briefing = "My bundle washed downstream. See the red cloth caught on the bridge? Look near the ford for the matching wrap. The west bank is quicker, but a wolf hunts there. Cross here for the quiet east trail."
objective = "Find the red-wrapped bundle near Birchwater Ford"
return_objective = "Bring the bundle to the Birchwater ferryman"
turn_in_dialogue = "That's the one! Set it on the cart. The ferry can make its delivery after all."
target_object = &"birchwater_bundle"
reward_xp = 85
